      "shell": "cat > /tmp/opencode/ds_mst_ui.py <<'PYEOF'\nimport json, os, subprocess, sys, tempfile, time\n\nDRIVE = [\"python3\", \"qa/drive.py\", \"--port\", os.environ.get(\"PORT\") or os.environ.get(\"MST_QA_PORT\", \"8879\"),\n         \"--display\", os.environ.get(\"DISPLAY\", \":79\")]\n\n\ndef run(*a):\n    return subprocess.run(DRIVE + [str(x) for x in a], cwd=os.environ.get(\"ROOT\", \".\"),\n                          capture_output=True, text=True)\n\n\ndef dump():\n    p = tempfile.mktemp(suffix=\".json\")\n    r = run(\"ui\", \"--filter\", \"\", \"--save\", p)\n    if r.returncode:\n        sys.exit(\"ui failed: \" + r.stderr[-300:])\n    d = json.load(open(p)); os.unlink(p)\n    return [c for c in d[\"controls\"] if c.get(\"rect\") and c[\"rect\"][2] > 0 and c[\"rect\"][3] > 0 and c.get(\"visible\")]\n\n\ndef find(name, classes=None):\n    cs = dump()\n    if classes:\n        cs = [c for c in cs if c.get(\"class\") in classes]\n    hits = [c for c in cs if c.get(\"name\") == name] or [c for c in cs if c.get(\"text\") == name]\n    if not hits:\n        sys.exit(\"control not found: \" + name)\n    return hits[0]\n\n\ndef center(c):\n    x, y, w, h = c[\"rect\"]\n    return int(x + w / 2), int(y + h / 2)\n\n\ndef path(p):\n    return p if os.path.isabs(p) else os.path.join(os.environ.get(\"OUT\", \".\"), p)\n\n\ndef project(pt):\n    o = run(\"project\", \"--point\", json.dumps(pt)).stdout\n    try:\n        d = json.loads(o)\n    except Exception:\n        sys.exit(\"project failed: \" + o[-200:])\n    pts = d.get(\"points\") or []\n    if not pts:\n        sys.exit(\"project: no point\")\n    return pts[0][\"window\"]\n\n\ncmd = sys.argv[1]\nif cmd == \"crop\":\n    from PIL import Image\n    out, name = path(sys.argv[2]), sys.argv[3]\n    pads = [int(v) for v in sys.argv[4:8]]\n    c = find(name); x, y, w, h = c[\"rect\"]\n    tmp = tempfile.mktemp(suffix=\".png\"); run(\"capture\", tmp)\n    img = Image.open(tmp)\n    rect = (max(0, x - pads[0]), max(0, y - pads[2]), min(img.width, x + w + pads[1]), min(img.height, y + h + pads[3]))\n    img.crop(rect).save(out); os.unlink(tmp); print(out, rect)\nelif cmd == \"croppopup\":\n    from PIL import Image\n    out = path(sys.argv[2]); pad = int(sys.argv[3]) if len(sys.argv) > 3 else 12\n    pp = run(\"popups\"); pop = json.loads(pp.stdout)[\"popups\"][0]\n    x, y = pop[\"pos\"]; w, h = pop[\"size\"]\n    tmp = tempfile.mktemp(suffix=\".png\"); run(\"capture\", tmp)\n    img = Image.open(tmp)\n    rect = (max(0, x - pad), max(0, y - pad), min(img.width, x + w + pad), min(img.height, y + h + pad))\n    img.crop(rect).save(out); os.unlink(tmp); print(out, rect)\nelif cmd == \"cropwin\":\n    from PIL import Image\n    out = path(sys.argv[2]); x, y, w, h = [int(v) for v in sys.argv[3:7]]\n    tmp = tempfile.mktemp(suffix=\".png\"); run(\"capture\", tmp)\n    Image.open(tmp).crop((x, y, x + w, y + h)).save(out); os.unlink(tmp); print(out)\nelif cmd == \"cropat\":\n    from PIL import Image\n    out = path(sys.argv[2]); pt = [float(v) for v in sys.argv[3:6]]\n    w, h = int(sys.argv[6]), int(sys.argv[7])\n    x, y = project(pt)\n    tmp = tempfile.mktemp(suffix=\".png\"); run(\"capture\", tmp)\n    img = Image.open(tmp)\n    left = int(max(0, min(img.width - w, x - w / 2)))\n    top = int(max(0, min(img.height - h, y - h / 2)))\n    img.crop((left, top, left + w, top + h)).save(out); os.unlink(tmp); print(out, (left, top, w, h))\nelif cmd == \"full\":\n    out = path(sys.argv[2]); tmp = tempfile.mktemp(suffix=\".png\"); run(\"capture\", tmp)\n    os.replace(tmp, out); print(out)\nelif cmd == \"clickpoint\":\n    pt = [float(v) for v in sys.argv[2:5]]\n    x, y = project(pt)\n    args = [\"click\", int(x), int(y)]\n    rest = sys.argv[5:]\n    print(run(*(args + rest)).stdout[-100:])\nelif cmd == \"topview\":\n    cs = dump()\n    cand = [c for c in cs if c.get(\"class\") == \"MenuButton\" and 165 <= c[\"rect\"][1] <= 215\n            and c[\"rect\"][2] >= 100 and 380 <= c[\"rect\"][0] <= 700]\n    if not cand:\n        sys.exit(\"topview: no view menu\")\n    c = min(cand, key=lambda c: c[\"rect\"][1])\n    x, y = center(c)\n    pops = []\n    for _ in range(4):\n        run(\"click\", x, y); time.sleep(1.0)\n        p = run(\"popups\")\n        pops = json.loads(p.stdout).get(\"popups\", [])\n        if pops:\n            break\n        time.sleep(0.8)\n    if not pops:\n        sys.exit(\"topview: no popup\")\n    pop = pops[0]\n    for k, it in enumerate(pop[\"items\"]):\n        if it.get(\"text\") == \"Top View\":\n            px, py = pop[\"pos\"]\n            ih = pop[\"size\"][1] / max(len(pop[\"items\"]), 1)\n            run(\"click\", px + 40, int(py + ih * (k + 0.5))); time.sleep(0.8)\n            print(\"topview ok\")\n            break\n    else:\n        sys.exit(\"topview: item not found\")\nelif cmd == \"menupick\":\n    x, y, text = int(sys.argv[2]), int(sys.argv[3]), sys.argv[4]\n    run(\"click\", x, y); time.sleep(0.8)\n    p = run(\"popups\")\n    pops = json.loads(p.stdout).get(\"popups\", [])\n    if not pops:\n        sys.exit(\"menupick: no popup\")\n    for it in pops[0][\"items\"]:\n        if it.get(\"text\") == text:\n            ix, iy, iw, ih = it[\"rect\"]\n            run(\"click\", int(ix + iw / 2), int(iy + ih / 2)); time.sleep(0.6)\n            print(\"menupick\", text)\n            break\n    else:\n        sys.exit(\"menupick: item not found \" + text)\nelif cmd == \"recat\":\n    from PIL import Image\n    out = path(sys.argv[2]); pt = [float(v) for v in sys.argv[3:6]]\n    w, h = int(sys.argv[6]), int(sys.argv[7])\n    fps = sys.argv[8] if len(sys.argv) > 8 else \"12\"\n    mx = sys.argv[9] if len(sys.argv) > 9 else \"20\"\n    x, y = project(pt)\n    left = int(max(0, min(1920 - w, x - w / 2)))\n    top = int(max(0, min(1080 - h, y - h / 2)))\n    r = subprocess.run([\"qa/record.sh\", \"start\", out, \"--display\", os.environ.get(\"DISPLAY\", \":79\"),\n                        \"--rect\", f\"{left},{top},{w},{h}\", \"--fps\", fps, \"--max\", mx],\n                       cwd=os.environ.get(\"ROOT\", \".\"), capture_output=True, text=True)\n    print(\"recat\", left, top, w, h, r.returncode, r.stderr[-120:])\nelif cmd == \"movepoint\":\n    pt = [float(v) for v in sys.argv[2:5]]\n    x, y = project(pt)\n    print(run(\"move\", int(x), int(y)).stdout[-80:])\nelif cmd == \"find\":\n    c = find(sys.argv[2]); print(json.dumps(c, indent=1))\nelif cmd == \"popick\":\n    x, y, idx = int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])\n    run(\"click\", x, y); time.sleep(0.8)\n    p = run(\"popups\")\n    pops = json.loads(p.stdout).get(\"popups\", [])\n    if not pops:\n        sys.exit(\"popick: no popup\")\n    pop = pops[0]; px, py = pop[\"pos\"]\n    ih = pop[\"size\"][1] / max(len(pop[\"items\"]), 1)\n    run(\"click\", px + 30, int(py + ih * (idx + 0.5))); time.sleep(0.5)\n    print(\"popick\", idx)\nelif cmd == \"setat\":\n    x, y, val = int(sys.argv[2]), int(sys.argv[3]), sys.argv[4]\n    run(\"click\", x, y); time.sleep(0.4)\n    run(\"key\", \"a\", \"--ctrl\"); run(\"type\", val); run(\"key\", \"enter\"); time.sleep(0.5)\n    print(\"setat\", x, y, val)\nelse:\n    name = sys.argv[2]\n    cls = {\"option\": (\"OptionButton\",), \"slider\": (\"HSlider\",), \"spin\": (\"EditorSpinSlider\",),\n           \"check\": (\"CheckBox\",)}.get(cmd)\n    c = find(name, cls)\n    if cmd == \"click\":\n        print(run(\"click\", *center(c)).stdout[-100:])\n    elif cmd == \"check\":\n        want = sys.argv[3].lower() in (\"1\", \"on\", \"true\", \"yes\")\n        if bool(c.get(\"toggled\")) != want:\n            run(\"click\", *center(c)); time.sleep(0.3)\n        print(name, \"->\", want)\n    elif cmd == \"spin\":\n        x, y = center(c)\n        run(\"click\", x, y); time.sleep(0.4)\n        run(\"key\", \"a\", \"--ctrl\"); run(\"type\", sys.argv[3]); run(\"key\", \"enter\"); time.sleep(0.4)\n        print(name, \":=\", sys.argv[3])\n    elif cmd == \"slider\":\n        frac = max(0.0, min(1.0, float(sys.argv[3]))); x, y, w, h = c[\"rect\"]\n        tx = int(x + 2 + frac * (w - 4)); yy = int(y + h / 2)\n        run(\"drag\", tx - 1, yy, tx + 1, yy, \"--duration\", \"0.2\"); time.sleep(0.4)\n        print(name, \"->\", frac)\n    elif cmd == \"option\":\n        idx = int(sys.argv[3]); run(\"click\", *center(c)); time.sleep(0.8)\n        p = run(\"popups\")\n        pops = json.loads(p.stdout).get(\"popups\", [])\n        if not pops:\n            sys.exit(\"option: no popup opened for \" + name)\n        pop = pops[0]; px, py = pop[\"pos\"]\n        ih = pop[\"size\"][1] / max(len(pop[\"items\"]), 1)\n        run(\"click\", px + 30, int(py + ih * (idx + 0.5))); time.sleep(0.5)\n        print(name, \"->\", idx)\n\nPYEOF"
