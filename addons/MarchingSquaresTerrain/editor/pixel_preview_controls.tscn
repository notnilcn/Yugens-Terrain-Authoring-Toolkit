[node name="PixelPreviewButton" type="Button" parent="." unique_id=718142546]
layout_mode = 2
tooltip_text = "Show the editor viewport through the pixel renderer (the scene's PixelRenderer, or a default one).
The editor grid and origin axes are hidden while it is on; the move / rotate / scale gizmo and node gizmos still draw on top."
focus_mode = 0
toggle_mode = true
icon = ExtResource("1_cmvqd")
flat = true

[node name="PixelAnimateButton" type="Button" parent="." unique_id=1306079323]
layout_mode = 2
tooltip_text = "Animate Effects
Run the effects in the editor: clouds drift, water waves, grass sways, birds fly, weather and fire move.
Off: everything holds still, so the editor only redraws when something changes (much lighter). A running game always animates."
focus_mode = 0
toggle_mode = true
text = "Animate"
flat = true

