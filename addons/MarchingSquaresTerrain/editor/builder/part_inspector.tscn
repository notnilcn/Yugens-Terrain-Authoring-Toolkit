[node name="Part" type="FoldableContainer" parent="."]
layout_mode = 2
title = "Part"

[node name="Grid" type="GridContainer" parent="Part"]
layout_mode = 2
columns = 2

[node name="ShapeLabel" type="Label" parent="Part/Grid"]
layout_mode = 2
text = "Shape"

[node name="PartShape" type="Label" parent="Part/Grid"]
layout_mode = 2
size_flags_horizontal = 3

[node name="LockedLabel" type="Label" parent="Part/Grid"]
layout_mode = 2
text = "Locked"

[node name="PartLocked" type="CheckBox" parent="Part/Grid"]
layout_mode = 2
tooltip_text = "Locked parts cannot be clicked in the viewport"

[node name="AnchoredLabel" type="Label" parent="Part/Grid"]
layout_mode = 2
text = "Anchored"

[node name="PartAnchored" type="CheckBox" parent="Part/Grid"]
layout_mode = 2
tooltip_text = "Anchored to a terrain cell (the addon's anchoring, not physics)"
text = "terrain"

[node name="Behavior" type="FoldableContainer" parent="."]
layout_mode = 2
