[node name="Grid" type="GridContainer" parent="Behavior"]
layout_mode = 2
columns = 2

[node name="CollisionLabel" type="Label" parent="Behavior/Grid"]
layout_mode = 2
text = "Collision"

[node name="PartCollision" type="OptionButton" parent="Behavior/Grid"]
layout_mode = 2
size_flags_horizontal = 3
selected = 0
item_count = 3
popup/item_0/text = "None"
popup/item_0/id = 0
popup/item_1/text = "Collider"
popup/item_1/id = 1
popup/item_2/text = "Trigger"
popup/item_2/id = 2

[node name="Separator" type="HSeparator" parent="."]
layout_mode = 2
