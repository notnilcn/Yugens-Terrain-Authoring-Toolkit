[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
windows.debug.x86_64 = "res://addons/phantom_camera_rust/bin/phantom_camera_rust.dll"
windows.release.x86_64 = "res://addons/phantom_camera_rust/bin/phantom_camera_rust_release.dll"
linux.debug.x86_64 = "res://addons/phantom_camera_rust/bin/libphantom_camera_rust.so"
linux.release.x86_64 = "res://addons/phantom_camera_rust/bin/libphantom_camera_rust_release.so"
macos.debug = "res://addons/phantom_camera_rust/bin/libphantom_camera_rust.dylib"
macos.release = "res://addons/phantom_camera_rust/bin/libphantom_camera_rust_release.dylib"
