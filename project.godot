[marching_squares_terrain]

features/clouds=true
features/god_rays=true
features/water=true
features/weather=true
features/birds=true
features/fireflies=true
features/smoke=true
features/fire=true
features/particles=true
features/light_volumes=true
features/sun_shafts=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
